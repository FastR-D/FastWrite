{
  "name": "@fastwrite/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun --external pdfjs-dist && rm -rf dist/skills dist/templates && cp -R src/skills dist/skills && mkdir -p dist/templates && cp -R src/templates/bundled dist/templates/bundled",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastrd/fastcas": "^0.1.1",
    "@fastwrite/harness-claude": "workspace:*",
    "@fastwrite/harness-codex": "workspace:*",
    "@fastwrite/harness-core": "workspace:*",
    "@fastwrite/harness-protocol": "workspace:*",
    "@fastwrite/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.2",
    "nodemailer": "^10.1.4",
    "openai": "^7.3.0",
    "pdfjs-dist": "^5.4.296",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3"
  }
}
