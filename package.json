{
  "name": "fastwrite-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "main": "bun scripts/dev.ts --main",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test ./apps/server/src ./apps/web/src ./packages/shared/src ./packages/harness-core/src ./packages/harness-protocol/src ./packages/harness-codex/src ./packages/harness-claude/src",
    "references:eval": "bun scripts/reference-writing-eval.ts",
    "writing:eval": "bun scripts/writing-eval.ts",
    "skills:eval:codex": "bun scripts/agent-writing-skills-eval.ts",
    "skills:eval:social": "bun scripts/social-writing-skills-eval.ts",
    "papers:eval": "bun scripts/papers-eval.ts",
    "papers:compile": "bun scripts/papers-compile.ts",
    "latex:check": "bash scripts/check-latex-linux.sh",
    "latex:setup": "bash scripts/setup-latex-linux.sh --install",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:cross-browser": "sh scripts/e2e-cross-browser.sh",
    "llm:smoke": "bun scripts/llm-smoke.ts",
    "ci:check": "sh scripts/ci-check.sh",
    "security:check": "bash scripts/security-check.sh",
    "start": "bun apps/server/src/server.ts",
    "backup:restore": "bun scripts/restore-backup.ts",
    "worker:jobs": "bun apps/server/src/jobs/job-worker.ts",
    "worker:mail": "bun apps/server/src/notifications/mail-worker.ts",
    "storage:postgres:migrate": "bun scripts/postgres-migrate.ts",
    "e2e:editor": "node scripts/e2e-editor-reliability.mjs",
    "e2e:ai-workspace": "node scripts/e2e-ai-workspace.mjs",
    "e2e:workbench-ui": "node scripts/e2e-workbench-ui.mjs",
    "e2e:projects-ui": "node scripts/e2e-projects-ui.mjs",
    "e2e:panel-teams": "node scripts/e2e-panel-teams.mjs",
    "e2e:new-paper": "node scripts/e2e-new-paper.mjs",
    "e2e:typography": "node scripts/e2e-typography.mjs",
    "e2e:sidebar-evidence": "node scripts/e2e-sidebar-evidence.mjs",
    "e2e:compile-snapshot": "node scripts/e2e-compile-snapshot.mjs",
    "e2e:workbench": "node scripts/e2e-workbench.mjs",
    "e2e:settings-editor": "node scripts/e2e-settings-editor.mjs",
    "e2e:shared-buffer": "node scripts/e2e-shared-buffer.mjs",
    "e2e:collaboration-barrier": "node scripts/e2e-collaboration-barrier.mjs",
    "e2e:collaboration-provider": "node scripts/e2e-collaboration-provider.mjs",
    "e2e:two-checkpoints": "node scripts/e2e-two-checkpoints.mjs",
    "e2e:current-changes": "node scripts/e2e-current-changes.mjs",
    "e2e:references": "node scripts/e2e-reference-papers.mjs",
    "e2e:skills": "node scripts/e2e-builtin-skills.mjs",
    "e2e:evidence-outline": "node scripts/e2e-evidence-outline.mjs",
    "e2e:bottom-panel-layout": "node scripts/e2e-bottom-panel-layout.mjs",
    "e2e:editor-matrix": "node scripts/e2e-editor-matrix.mjs",
    "e2e:workbench-performance": "node scripts/e2e-workbench-performance.mjs",
    "e2e:large-document": "node scripts/e2e-large-document.mjs",
    "e2e:paper-collaboration": "node scripts/e2e-paper-collaboration.mjs",
    "e2e:sidebar-workflow": "node scripts/e2e-sidebar-workflow.mjs",
    "e2e:latex-services": "node scripts/e2e-latex-services.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/node": "24.3.0",
    "axe-core": "^4.12.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "patchedDependencies": {
    "monaco-editor@0.56.0": "patches/monaco-editor@0.56.0.patch"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
