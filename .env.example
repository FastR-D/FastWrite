# Development ports
FASTWRITE_WEB_PORT=3002
FASTWRITE_PORT=3003

# Optional: keep the default API proxy when empty.
# FASTWRITE_API_ORIGIN=http://localhost:3003

# Optional: OpenAI-compatible provider
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# FASTWRITE_OPENAI_MODEL=
# FASTWRITE_OPENAI_WIRE_API=responses
# FASTWRITE_AGENT_TIMEOUT_MS=300000

# Harness used by Agent tasks when no per-request choice is made (codex, claude, or legacy).
# FASTWRITE_HARNESS=codex

# Optional: local data directory
# FASTWRITE_DATA_DIR=.fastwrite-data
