# Development ports
FASTWRITE_WEB_PORT=3002
FASTWRITE_PORT=3003

# Optional: keep the default API proxy when empty.
# FASTWRITE_API_ORIGIN=http://localhost:3003

# API Keys for external service integration (JSON array)
#
# 方式一：服务级别的 API Key（不绑定用户）
# 适用于：服务间通信，不需要用户级别权限控制
# Example: [{"key":"your-secret-key","name":"FastResearch","scopes":["project:list","project:read"],"createdAt":"2024-01-01T00:00:00.000Z"}]
#
# 方式二：FastResearch 外部账户映射（个人 Key 跳转推荐）
# 不配置 userId；FastResearch 请求中的 externalAccountId 会自动映射到独立账户
# Example: [{"key":"your-secret-key","name":"FastResearch","scopes":["project:list","project:read","project:create","project:compile"],"createdAt":"2024-01-01T00:00:00.000Z"}]
#
# 方式三：用户级别的 API Key（固定单用户集成）
# 需要先在 FastWrite 中创建用户账户，获取 userId
# Example: [{"key":"your-secret-key","name":"FastResearch-张三","userId":"user_xxx","email":"zhangsan@example.com","scopes":["project:list","project:read","project:create","project:compile"],"createdAt":"2024-01-01T00:00:00.000Z"}]
#
# 可选字段：
# - userId: FastWrite 用户 ID（如 user_abc123），绑定后该 Key 只能访问该用户的项目
# - email: 用户邮箱（可选，用于显示和审计）
# - expiresAt: 过期时间（ISO 8601 格式，如 "2025-12-31T23:59:59.000Z"）
#
# FASTWRITE_API_KEYS=

# Harness configuration
# FASTWRITE_HARNESS_API_KEY=
# FASTWRITE_HARNESS_BASE_URL=https://api.openai.com/v1
# FASTWRITE_HARNESS_MODEL=
# FASTWRITE_HARNESS_WIRE_API=responses
# FASTWRITE_HARNESS_TIMEOUT_MS=300000

# Harness used by all AI tasks (codex or claude).
# FASTWRITE_HARNESS=codex

# Optional: local data directory
# FASTWRITE_DATA_DIR=.fastwrite-data

# Enable server authentication (required for user-level API Keys)
# FASTWRITE_SERVER_AUTH=true
