# Development ports
FASTWRITE_WEB_PORT=3002
FASTWRITE_PORT=3003

# Server authentication: first startup requires an explicitly chosen administrator.
# FASTWRITE_SERVER_AUTH=true
# FASTWRITE_BOOTSTRAP_ADMIN_EMAIL=
# FASTWRITE_BOOTSTRAP_ADMIN_PASSWORD=
# Choose a unique password of at least 12 characters. Remove both bootstrap
# variables after initialization; changing them does not reset an existing account.

# Optional: keep the default API proxy when empty.
# FASTWRITE_API_ORIGIN=http://localhost:3003

# Harness configuration
# FASTWRITE_HARNESS_API_KEY=
# FASTWRITE_HARNESS_BASE_URL=https://api.openai.com/v1
# FASTWRITE_HARNESS_MODEL=
# FASTWRITE_HARNESS_WIRE_API=responses
# FASTWRITE_HARNESS_TIMEOUT_MS=300000

# Harness used by all AI tasks (codex or claude).
# FASTWRITE_HARNESS=codex

# Optional: local data directory
# FASTWRITE_DATA_DIR=.fastwrite-data

# Optional research adapters. Only server-configured destinations can be used.
# Set these to trusted services; redirects to other destinations are rejected.
# FASTWRITE_RESEARCH_ZOTERO_BASE_URL=http://127.0.0.1:23119
# FASTWRITE_RESEARCH_GROBID_BASE_URL=http://127.0.0.1:8070
# FASTWRITE_RESEARCH_PANDOC_BASE_URL=http://127.0.0.1:3030
